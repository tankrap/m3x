{
  "name": "@ibx34/m3x-tokens",
  "version": "0.1.0",
  "description": "Material 3 + Expressive design tokens: dynamic color, typography, shape, elevation, state layers, motion physics. Not affiliated with or endorsed by Google.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tankrap/m3x.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "publishConfig": {
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
